<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0;</TargetFrameworks>
        <DocumentationFile>$(DocumentationFile)\$(AssemblyName).xml</DocumentationFile>
        <PackageId>Microsoft.OData.Mcp.Authentication</PackageId>
        <Title>Microsoft OData for AI — Authentication</Title>
        <Description>Outbound OAuth client used by Local MCP (odata-mcp) to sign in to an OData API. Not inbound MCP OAuth.</Description>
        <PackageTags>odata;mcp;oauth;authentication</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Latchkey" Version="0.1.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
        <PackageReference Include="ModelContextProtocol" Version="2.*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.*-*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.Extensions.Http" Version="9.*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.Http" Version="8.*" />
    </ItemGroup>

</Project>
