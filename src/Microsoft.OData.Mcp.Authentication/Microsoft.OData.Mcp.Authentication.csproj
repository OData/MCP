<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0;</TargetFrameworks>
        <DocumentationFile>$(DocumentationFile)\$(AssemblyName).xml</DocumentationFile>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <PackageId>Microsoft.OData.Mcp.Authentication</PackageId>
        <Title>Microsoft OData MCP Authentication</Title>
        <Description>Outbound OAuth client for remote OData (CLI hop 2). Types land in Outbound/ per specs/v3/AUTHENTICATION.md.</Description>
        <PackageTags>odata;mcp;oauth;authentication</PackageTags>
    </PropertyGroup>

</Project>
