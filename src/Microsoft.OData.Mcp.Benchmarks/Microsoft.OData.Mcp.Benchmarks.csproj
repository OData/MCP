<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CA1001;CA1707;CA1822;CA2007</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageReference Include="Microsoft.OData.Edm" Version="7.*" />
        <PackageReference Include="SharpToken" Version="2.0.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Microsoft.OData.Mcp.Core\Microsoft.OData.Mcp.Core.csproj" />
        <ProjectReference Include="..\Microsoft.OData.Mcp.Tests.Shared\Microsoft.OData.Mcp.Tests.Shared.csproj" />
    </ItemGroup>

    <!-- The Breakdance baselines stay in Tests.Core (they are what the tests assert). They are linked here, not copied,
         so the token reports always read the files the tests read. -->
    <ItemGroup>
        <Content Include="..\Microsoft.OData.Mcp.Tests.Core\Baselines\TypeShapes\**\*" Exclude="..\Microsoft.OData.Mcp.Tests.Core\Baselines\TypeShapes\**\*.md" Link="Baselines\TypeShapes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
